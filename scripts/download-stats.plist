<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.tep-lab.kakiire.download-stats</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/opt/dev/Kakiire/scripts/download-stats.py</string>
		<string>/Users/YOU/Library/Application Support/Kakiire/download-stats</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/Library/Logs/kakiire-download-stats.log</string>
	<key>StandardOutPath</key>
	<string>/Users/YOU/Library/Logs/kakiire-download-stats.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
